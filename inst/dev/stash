```{r compare-section-values, eval=TRUE, echo=TRUE}
# Extract variables from params - be careful with conversions
if (params$include_compare && !is.null(params$compare_values)) {
  # Safely extract variable names and convert symbols to strings
  get_var_name <- function(var_symbol) {
    if (is.symbol(var_symbol)) {
      return(as.character(var_symbol))
    } else if (is.character(var_symbol)) {
      return(var_symbol)
    } else {
      return(NULL)
    }
  }
  # Get actual column names from the original movie data
  # This handles the case sensitivity and exact column naming
  get_column_name <- function(pretty_name) {
    # match the pretty name to the original column
    # convert to lower to do case-insensitive matching
    col_name <- tolower(gsub(" ", "_", pretty_name))
    # find matching column in the original data
    all_cols <- tolower(colnames(movies))
    match_idx <- which(all_cols == col_name)
    if (length(match_idx) == 1) {
      return(colnames(movies)[match_idx])
    } else {
      warning(paste("Cannot find column matching:", pretty_name))
      return(NULL)
    }
  }
  
  # process variable names
  x_var_name <- get_var_name(params$compare_values$x)
  y_var_name <- get_var_name(params$compare_values$y)
  color_var_name <- get_var_name(params$compare_values$color)
  
  # actual column names
  x_col <- get_column_name(x_var_name)
  y_col <- get_column_name(y_var_name)
  color_col <- get_column_name(color_var_name)
  
  # Extract other parameters
  alpha <- params$compare_values$alpha
  size <- params$compare_values$size
  title_text <- if (!is.null(params$compare_values$title) && 
                     nchar(params$compare_values$title) > 0) {
    params$compare_values$title
  } else {
    paste(name_case(x_var_name), "vs", name_case(y_var_name))
  }
  comp_vals <- list(
    'x' = x_col,
    'y' = y_col,
    'color' = color_col,
    'alpha' = alpha,
    'size' = size,
    'title' = title_text
  )
}
